# Copy to dev.env, test.env, or prod.env. Select at runtime with APP_ENV=dev|test|prod.
# Secrets are read from ~/.config/gcloud/application_default_credentials.json at startup.
# Run `gcloud auth application-default login` to populate it.
CREDENTIAL_SOURCE=gcloud_adc
GCLOUD_FIELD_MAP=client_id:GOOGLE_CLIENT_ID,client_secret:GOOGLE_CLIENT_SECRET,refresh_token:GOOGLE_REFRESH_TOKEN
