# Copy to dev.env, test.env, or prod.env. Select at runtime with APP_ENV=dev|test|prod.
#
# Auth: Vertex AI via gcloud Application Default Credentials (OAuth).
# Run `gcloud auth application-default login` once; the google-genai SDK then
# mints + auto-refreshes short-lived access tokens at call time. No secrets on disk.
CREDENTIAL_SOURCE=gcloud_adc
GCLOUD_FIELD_MAP=
# Your GCP project ID with the Vertex AI API enabled.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Attributes ADC quota to the project and silences the gcloud "no quota project"
# warning. Keep equal to GOOGLE_CLOUD_PROJECT.
GOOGLE_CLOUD_QUOTA_PROJECT=your-gcp-project-id

# Backend (#2563): vertex (default) or databricks.
# databricks = Databricks-hosted Gemini image endpoints, authenticated with a
# Databricks CLI profile's OAuth tokens. Neither backend needs a Google API key,
# and with databricks the GOOGLE_* values above are unused.
# These two keys are the exception to "this file wins": a value already set in the
# launching process environment beats the one here (#2611).
# GEMINI_IMAGE_BACKEND=databricks
# GEMINI_IMAGE_DATABRICKS_PROFILE=your-databricks-profile
