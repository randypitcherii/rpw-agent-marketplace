{
  "_comment": "Backends the `rpw` aggregator fronts (#2215). Same shape as .mcp.json mcpServers; this is the list to edit when adding a server. The plugin's .mcp.json holds only the aggregator.",
  "mcpServers": {
    "google-tasks": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-tasks",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-tasks/run_mcp.py"
      ]
    },
