# Copy to dev.env, test.env, or prod.env. Select at runtime with APP_ENV=dev|test|prod.
# This file holds NO Databricks/UC credentials — `imsg` is authorized by macOS
# Full Disk Access + Automation permission, not by a token.
#
# NOTIFY_ME_HANDLE is the ONLY recipient the send-only `imessage_notify_me` tool can
# reach. Set it to your own phone number (E.164, e.g. +12025550123) or your iMessage
# email. Sending to your own handle delivers the alert to all your Apple devices.
# This is your phone number / PII — keep dev.env local-only, never commit it.
NOTIFY_ME_HANDLE=

# Service for the alert send: imessage (default), sms, or auto.
NOTIFY_ME_SERVICE=imessage

# Optional: absolute path to the imsg binary if not on PATH.
# IMSG_BIN=/opt/homebrew/bin/imsg
