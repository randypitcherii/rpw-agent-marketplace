# Copy to dev.env, test.env, or prod.env. Select at runtime with APP_ENV=dev|test|prod.
#
# This server reaches the Jira REST API through a Databricks Unity Catalog
# HTTP-proxy connection, so no raw Jira token is stored here — `uc_proxy`
# validates your access to the connection and exports UC_PROXY_* at startup.
#
# --- Databricks UC-connection routing (required for this server) ---
# Replace both placeholders with your own values. There is no default profile
# or connection name — supply the ones your workspace exposes.
CREDENTIAL_SOURCE=uc_proxy
DATABRICKS_PROFILE=<your-databricks-profile>
UC_CONNECTION_NAME=<your-jira-uc-connection>
