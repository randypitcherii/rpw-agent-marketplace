# Copy to dev.env, test.env, or prod.env. Select at runtime with APP_ENV=dev|test|prod.
# This server calls `gcloud auth application-default print-access-token` at runtime
# to mint a fresh token, so no secrets are stored. You still need these non-secret IDs:
CREDENTIAL_SOURCE=gcloud_adc
GCLOUD_FIELD_MAP=
# Your GCP project ID for API quota attribution (required).
GDOCS_QUOTA_PROJECT=your-gcp-project-id
# Default Drive folder ID for create/list operations (required).
GDOCS_TARGET_FOLDER_ID=your-drive-folder-id
# Optional: comma-separated folder IDs allowed for operations (overrides the single folder).
# GDOCS_ALLOWED_FOLDERS=folder1,folder2,folder3
# Optional: read-only mode — blocks create, update, delete, add_tab, find_replace, write_to_tab.
# GDOCS_READ_ONLY=false
# Optional: path to an append-only audit log file (one line per mutation).
# GDOCS_AUDIT_LOG_PATH=/tmp/gdocs_mcp_audit.log
