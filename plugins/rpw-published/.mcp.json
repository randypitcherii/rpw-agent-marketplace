{
  "_comment": "Publicly-shareable MCP servers for rpw-published. chrome-devtools is provided via the chrome-devtools-mcp plugin dependency from claude-plugins-official. Private servers live in plugins/rpw-private/.mcp.json. The imessage server (#284) is not yet activated here pending completion of that work.",
  "mcpServers": {
    "google-tasks": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-tasks",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-tasks/run_mcp.py"
      ]
    },
    "google-docs": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-docs",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-docs/run_mcp.py"
      ]
    },
    "gemini-image": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/gemini-image",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/gemini-image/run_mcp.py"
      ]
    },
    "google-drive": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-drive",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-drive/run_mcp.py"
      ]
    },
    "google-gmail": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-gmail",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-gmail/run_mcp.py"
      ]
    },
    "google-calendar": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-calendar",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/google-calendar/run_mcp.py"
      ]
    },
    "jira": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/jira",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/jira/run_mcp.py"
      ]
    },
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.exa.ai/mcp"
      ]
    }
  }
